#!/usr/bin/env bash
set -euo pipefail

# --- Colors & Symbols ---
# shellcheck source=lib/colors.sh
source "$(dirname "${BASH_SOURCE[0]}")/lib/colors.sh"
# shellcheck source=lib/links.sh
source "$(dirname "${BASH_SOURCE[0]}")/lib/links.sh"

SYM_OK="✔"
SYM_ERR="✖"
SYM_WARN="⚠"
SYM_INFO="ℹ"
SYM_LINK="🔗"
SYM_BACKUP="📦"
SYM_SECRET="🔒"
SYM_PY="🐍"

# --- Configuration ---
DOTFILES_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BACKUP_DIR="${HOME}/.dotfiles-backup/$(date +%Y%m%d-%H%M%S)"
DRY_RUN=0

# Summary counters, reported at the end.
N_LINKED=0
N_ALREADY=0
N_SKIPPED=0
N_BACKED_UP=0

# --- Helper Functions ---
log_info() { printf '%s%s %s%s\n' "$CL_BLUE" "$SYM_INFO" "$1" "$CL_RESET"; }
log_success() { printf '%s%s %s%s\n' "$CL_GREEN" "$SYM_OK" "$1" "$CL_RESET"; }
log_warn() { printf '%s%s %s%s\n' "$CL_YELLOW" "$SYM_WARN" "$1" "$CL_RESET"; }
log_error() { printf '%s%s %s%s\n' "$CL_RED" "$SYM_ERR" "$1" "$CL_RESET"; }
log_header() { printf '\n%s%s==> %s%s\n' "$CL_BOLD" "$CL_MAGENTA" "$1" "$CL_RESET"; }

usage() {
  cat <<USAGE
${CL_BOLD}Dotfiles Installer${CL_RESET}

Usage: ./install [--dry-run]

Creates symlinks from this repo into your home directory.
Existing files are moved to ~/.dotfiles-backup/<timestamp> first.

Options:
  --dry-run   Show what would change without modifying files.
  -h, --help  Show this help.
USAGE
}

for arg in "$@"; do
  case "$arg" in
    --dry-run)
      DRY_RUN=1
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      log_error "Unknown option: $arg"
      usage
      exit 1
      ;;
  esac
done

if [[ "$DRY_RUN" -eq 1 ]]; then
  log_warn "Running in DRY-RUN mode. No changes will be made."
fi

if ! command -v brew >/dev/null 2>&1; then
  log_error "Homebrew not found. Install it first: https://brew.sh"
  exit 1
fi

run() {
  if [[ "$DRY_RUN" -eq 1 ]]; then
    printf '%s[dry-run]%s %q' "$CL_CYAN" "$CL_RESET" "$1"
    shift
    [[ $# -gt 0 ]] && printf " %q" "$@"
    printf "\n"
  else
    "$@"
  fi
}

ensure_backup_dir() {
  if [[ ! -d "$BACKUP_DIR" ]]; then
    if [[ "$DRY_RUN" -eq 1 ]]; then
      log_info "Would create backup directory: ${CL_BOLD}${BACKUP_DIR}${CL_RESET}"
    else
      mkdir -p "$BACKUP_DIR"
      log_info "Created backup directory: ${CL_BOLD}${BACKUP_DIR}${CL_RESET}"
    fi
  fi
}

link_file() {
  local source="$1"
  local target="$2"
  local target_name
  target_name="$(basename "$target")"

  if [[ ! -e "$source" ]]; then
    log_warn "Skipping (source not found): $source"
    N_SKIPPED=$((N_SKIPPED + 1))
    return
  fi

  if [[ -L "$target" && "$(readlink "$target")" == "$source" ]]; then
    log_success "Already linked: ${CL_CYAN}${target}${CL_RESET} -> ${CL_YELLOW}${source}${CL_RESET}"
    N_ALREADY=$((N_ALREADY + 1))
    return
  fi

  if [[ -e "$target" || -L "$target" ]]; then
    ensure_backup_dir
    log_info "${SYM_BACKUP} Backing up: ${CL_BOLD}${target}${CL_RESET}"
    run mv "$target" "${BACKUP_DIR}/${target_name}"
    N_BACKED_UP=$((N_BACKED_UP + 1))
  fi

  local parent_dir
  parent_dir="$(dirname "$target")"
  if [[ ! -d "$parent_dir" ]]; then
    log_info "Creating parent directory: ${CL_BOLD}${parent_dir}${CL_RESET}"
    run mkdir -p "$parent_dir"
  fi

  log_info "${SYM_LINK} Linking: ${CL_CYAN}${target}${CL_RESET} -> ${CL_YELLOW}${source}${CL_RESET}"
  run ln -s "$source" "$target"
  N_LINKED=$((N_LINKED + 1))
}

ensure_local_file() {
  local source="${DOTFILES_DIR}/.zshrc.local.example"
  local target="${HOME}/.zshrc.local"

  log_header "Local Overrides"

  if [[ ! -e "$source" ]]; then
    log_error "Missing source: $source"
    exit 1
  fi

  if [[ -e "$target" ]]; then
    log_success "Local overrides exist: ${CL_BOLD}${target}${CL_RESET}"
    run chmod 600 "$target"
  else
    log_info "Creating local overrides: ${CL_BOLD}${target}${CL_RESET}"
    run cp "$source" "$target"
    run chmod 600 "$target"
  fi

  log_info "${SYM_SECRET} Secrets live in Keychain: ${CL_BOLD}secret add NAME${CL_RESET} (see README)"
  if [[ -e "${HOME}/.zshrc-secrets" || -e "${HOME}/.config/openai.token" ]]; then
    log_warn "Plaintext secrets still on disk (~/.zshrc-secrets, ~/.config/openai.token) — move them with \`secret add\`, then delete."
  fi
}

# ~/.ssh/config stays local (private hosts; gcloud writes to it). It only has
# to pull in the tracked defaults, and the Include must be line 1: one placed
# after a Host block belongs to that block.
ensure_ssh_include() {
  local ssh_dir="${HOME}/.ssh"
  local config="${ssh_dir}/config"
  local include_line="Include ~/.ssh/dotfiles.conf"

  log_header "SSH"

  if [[ ! -d "$ssh_dir" ]]; then
    log_info "Creating ${CL_BOLD}${ssh_dir}${CL_RESET} (700)"
    run mkdir -m 700 "$ssh_dir"
  fi

  if [[ ! -e "$config" ]]; then
    log_info "Creating ${CL_BOLD}${config}${CL_RESET} (600)"
    if [[ "$DRY_RUN" -eq 0 ]]; then
      printf '%s\n' "$include_line" > "$config"
    fi
    run chmod 600 "$config"
    return
  fi

  if [[ "$(head -n 1 "$config")" == "$include_line" ]]; then
    log_success "SSH defaults included: ${CL_BOLD}${config}${CL_RESET}"
    return
  fi

  ensure_backup_dir
  log_info "${SYM_BACKUP} Backing up: ${CL_BOLD}${config}${CL_RESET}"
  run cp -p "$config" "${BACKUP_DIR}/ssh_config"
  log_info "Prepending ${CL_BOLD}${include_line}${CL_RESET} to ${config}"
  if [[ "$DRY_RUN" -eq 0 ]]; then
    local tmp
    tmp="$(mktemp "${config}.XXXXXX")"
    { printf '%s\n\n' "$include_line"; grep -vxF "$include_line" "$config" || true; } > "$tmp"
    chmod 600 "$tmp"
    mv "$tmp" "$config"
  fi
}

ensure_nvim_python_provider() {
  local venv_dir="${HOME}/.local/share/nvim/python-provider"
  local python_bin="${venv_dir}/bin/python"
  local python3_bin=""

  log_header "Neovim Python Provider"

  if [[ -x "$python_bin" ]] && "$python_bin" -c 'import pynvim' >/dev/null 2>&1; then
    log_success "Neovim Python provider ready: ${CL_BOLD}${python_bin}${CL_RESET}"
    return
  fi

  for candidate in /opt/homebrew/bin/python3 /usr/local/bin/python3 python3; do
    if command -v "$candidate" >/dev/null 2>&1; then
      python3_bin="$(command -v "$candidate")"
      break
    fi
  done

  if [[ -z "$python3_bin" ]]; then
    log_warn "python3 not found — skipping Neovim Python provider. Run \`make deps\` first."
    return
  fi

  log_info "${SYM_PY} Installing Neovim Python provider: ${CL_BOLD}${venv_dir}${CL_RESET}"
  if [[ "$DRY_RUN" -eq 1 ]]; then
    log_info "Would run: $python3_bin -m venv $venv_dir"
    log_info "Would run: $python_bin -m pip install --upgrade pip pynvim"
    return
  fi

  "$python3_bin" -m venv "$venv_dir"
  "$python_bin" -m pip install --upgrade pip pynvim
  log_success "Neovim Python provider installed."
}

ensure_zsh_custom_repo() {
  local repo_url="$1"
  local target_path="$2"
  local name="$3"

  if [[ -d "$target_path" ]]; then
    log_success "ZSH $name ready: ${CL_BOLD}${target_path}${CL_RESET}"
    return
  fi

  log_info "Cloning ZSH $name: ${CL_BOLD}${target_path}${CL_RESET}"
  run git clone --depth=1 "$repo_url" "$target_path"
}

ensure_oh_my_zsh() {
  local omz_dir="${HOME}/.oh-my-zsh"

  log_header "Oh My Zsh"

  if [[ -d "$omz_dir" ]]; then
    log_success "Oh My Zsh ready: ${CL_BOLD}${omz_dir}${CL_RESET}"
    return
  fi

  log_info "Installing Oh My Zsh: ${CL_BOLD}${omz_dir}${CL_RESET}"
  if [[ "$DRY_RUN" -eq 1 ]]; then
    log_info "Would run: RUNZSH=no CHSH=no sh -c \"\$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)\""
    return
  fi

  RUNZSH=no CHSH=no sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)"
  log_success "Oh My Zsh installed."
}

ensure_ssh_include

log_header "Installing Dotfiles"
for_each_link link_file

ensure_local_file
ensure_nvim_python_provider
ensure_oh_my_zsh

log_header "ZSH Themes & Plugins"
zsh_custom="${HOME}/.oh-my-zsh/custom"
ensure_zsh_custom_repo "https://github.com/romkatv/powerlevel10k.git" "${zsh_custom}/themes/powerlevel10k" "Theme (p10k)"
ensure_zsh_custom_repo "https://github.com/zsh-users/zsh-syntax-highlighting.git" "${zsh_custom}/plugins/zsh-syntax-highlighting" "Plugin (syntax)"
ensure_zsh_custom_repo "https://github.com/zsh-users/zsh-autosuggestions.git" "${zsh_custom}/plugins/zsh-autosuggestions" "Plugin (autosuggestions)"

printf '\n%s%s✨ Installation Complete!%s\n' "$CL_BOLD" "$CL_GREEN" "$CL_RESET"
printf '   %slinked%s %-3d %salready%s %-3d %sbacked up%s %-3d %sskipped%s %d\n' \
  "$CL_GREEN" "$CL_RESET" "$N_LINKED" \
  "$CL_CYAN" "$CL_RESET" "$N_ALREADY" \
  "$CL_YELLOW" "$CL_RESET" "$N_BACKED_UP" \
  "$CL_MAGENTA" "$CL_RESET" "$N_SKIPPED"
if [[ -d "$BACKUP_DIR" ]]; then
  log_info "Backups stored in: ${CL_BOLD}${BACKUP_DIR}${CL_RESET}"
fi
echo
