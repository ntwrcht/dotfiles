#!/usr/bin/env bash
set -euo pipefail

# --- Colors & Symbols ---
# shellcheck source=lib/colors.sh
source "$(dirname "${BASH_SOURCE[0]}")/lib/colors.sh"

SYM_OK="✔"
SYM_ERR="✖"
SYM_WARN="⚠"
SYM_INFO="ℹ"
SYM_LINK="🔗"
SYM_BACKUP="📦"
SYM_SECRET="🔒"
SYM_PY="🐍"

# --- Configuration ---
DOTFILES_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BACKUP_DIR="${HOME}/.dotfiles-backup/$(date +%Y%m%d-%H%M%S)"
DRY_RUN=0

# --- Helper Functions ---
log_info() { printf "${CL_BLUE}${SYM_INFO} %b${CL_RESET}\n" "$1"; }
log_success() { printf "${CL_GREEN}${SYM_OK} %b${CL_RESET}\n" "$1"; }
log_warn() { printf "${CL_YELLOW}${SYM_WARN} %b${CL_RESET}\n" "$1"; }
log_error() { printf "${CL_RED}${SYM_ERR} %b${CL_RESET}\n" "$1"; }
log_header() { printf "\n${CL_BOLD}${CL_MAGENTA}==> %b${CL_RESET}\n" "$1"; }

usage() {
  cat <<USAGE
${CL_BOLD}Dotfiles Installer${CL_RESET}

Usage: ./install [--dry-run]

Creates symlinks from this repo into your home directory.
Existing files are moved to ~/.dotfiles-backup/<timestamp> first.

Options:
  --dry-run   Show what would change without modifying files.
  -h, --help  Show this help.
USAGE
}

for arg in "$@"; do
  case "$arg" in
    --dry-run)
      DRY_RUN=1
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      log_error "Unknown option: $arg"
      usage
      exit 1
      ;;
  esac
done

if [[ "$DRY_RUN" -eq 1 ]]; then
  log_warn "Running in DRY-RUN mode. No changes will be made."
fi

run() {
  if [[ "$DRY_RUN" -eq 1 ]]; then
    printf "${CL_CYAN}[dry-run]${CL_RESET} %q" "$1"
    shift
    [[ $# -gt 0 ]] && printf " %q" "$@"
    printf "\n"
  else
    "$@"
  fi
}

ensure_backup_dir() {
  if [[ ! -d "$BACKUP_DIR" ]]; then
    if [[ "$DRY_RUN" -eq 1 ]]; then
      log_info "Would create backup directory: ${CL_BOLD}${BACKUP_DIR}${CL_RESET}"
    else
      mkdir -p "$BACKUP_DIR"
      log_info "Created backup directory: ${CL_BOLD}${BACKUP_DIR}${CL_RESET}"
    fi
  fi
}

link_file() {
  local source="$1"
  local target="$2"
  local target_name
  target_name="$(basename "$target")"

  if [[ ! -e "$source" ]]; then
    log_error "Missing source: $source"
    exit 1
  fi

  if [[ -L "$target" && "$(readlink "$target")" == "$source" ]]; then
    log_success "Already linked: ${CL_CYAN}${target}${CL_RESET} -> ${CL_YELLOW}${source}${CL_RESET}"
    return
  fi

  if [[ -e "$target" || -L "$target" ]]; then
    ensure_backup_dir
    log_info "${SYM_BACKUP} Backing up: ${CL_BOLD}${target}${CL_RESET}"
    run mv "$target" "${BACKUP_DIR}/${target_name}"
  fi

  log_info "${SYM_LINK} Linking: ${CL_CYAN}${target}${CL_RESET} -> ${CL_YELLOW}${source}${CL_RESET}"
  run ln -s "$source" "$target"
}

ensure_secrets_file() {
  local source="${DOTFILES_DIR}/.zshrc-secrets.example"
  local target="${HOME}/.zshrc-secrets"

  log_header "Secrets Management"

  if [[ ! -e "$source" ]]; then
    log_error "Missing source: $source"
    exit 1
  fi

  if [[ -e "$target" ]]; then
    log_success "Secrets file exists: ${CL_BOLD}${target}${CL_RESET}"
    run chmod 600 "$target"
    return
  fi

  log_info "${SYM_SECRET} Creating secrets file: ${CL_BOLD}${target}${CL_RESET}"
  run cp "$source" "$target"
  run chmod 600 "$target"
  log_warn "Action Required: Edit ${CL_BOLD}${target}${CL_RESET} and replace placeholder values."
}

ensure_nvim_python_provider() {
  local venv_dir="${HOME}/.local/share/nvim/python-provider"
  local python_bin="${venv_dir}/bin/python"
  local python3_bin=""

  log_header "Neovim Python Provider"

  if [[ -x "$python_bin" ]] && "$python_bin" -c 'import pynvim' >/dev/null 2>&1; then
    log_success "Neovim Python provider ready: ${CL_BOLD}${python_bin}${CL_RESET}"
    return
  fi

  for candidate in /opt/homebrew/bin/python3 /usr/local/bin/python3 python3; do
    if command -v "$candidate" >/dev/null 2>&1; then
      python3_bin="$(command -v "$candidate")"
      break
    fi
  done

  if [[ -z "$python3_bin" ]]; then
    log_error "Missing python3: install it via Homebrew or system package manager."
    exit 1
  fi

  log_info "${SYM_PY} Installing Neovim Python provider: ${CL_BOLD}${venv_dir}${CL_RESET}"
  if [[ "$DRY_RUN" -eq 1 ]]; then
    log_info "Would run: $python3_bin -m venv $venv_dir"
    log_info "Would run: $python_bin -m pip install --upgrade pip pynvim"
    return
  fi

  "$python3_bin" -m venv "$venv_dir"
  "$python_bin" -m pip install --upgrade pip pynvim
  log_success "Neovim Python provider installed."
}

ensure_zsh_custom_repo() {
  local repo_url="$1"
  local target_path="$2"
  local name="$3"

  if [[ -d "$target_path" ]]; then
    log_success "ZSH $name ready: ${CL_BOLD}${target_path}${CL_RESET}"
    return
  fi

  log_info "Cloning ZSH $name: ${CL_BOLD}${target_path}${CL_RESET}"
  run git clone --depth=1 "$repo_url" "$target_path"
}

log_header "Installing Dotfiles"
link_file "${DOTFILES_DIR}/.vimrc" "${HOME}/.vimrc"
link_file "${DOTFILES_DIR}/.zshrc" "${HOME}/.zshrc"
link_file "${DOTFILES_DIR}/.config/nvim"  "${HOME}/.config/nvim"
link_file "${DOTFILES_DIR}/.config/kitty" "${HOME}/.config/kitty"
link_file "${DOTFILES_DIR}/.config/git"   "${HOME}/.config/git"
link_file "${DOTFILES_DIR}/.gitconfig" "${HOME}/.gitconfig"
link_file "${DOTFILES_DIR}/.tmux.conf" "${HOME}/.tmux.conf"
link_file "${DOTFILES_DIR}/.tmux.conf.local" "${HOME}/.tmux.conf.local"
link_file "${DOTFILES_DIR}/.editorconfig" "${HOME}/.editorconfig"

ensure_secrets_file
ensure_nvim_python_provider

log_header "ZSH Themes & Plugins"
zsh_custom="${HOME}/.oh-my-zsh/custom"
ensure_zsh_custom_repo "https://github.com/romkatv/powerlevel10k.git" "${zsh_custom}/themes/powerlevel10k" "Theme (p10k)"
ensure_zsh_custom_repo "https://github.com/zsh-users/zsh-syntax-highlighting.git" "${zsh_custom}/plugins/zsh-syntax-highlighting" "Plugin (syntax)"
ensure_zsh_custom_repo "https://github.com/zsh-users/zsh-autosuggestions.git" "${zsh_custom}/plugins/zsh-autosuggestions" "Plugin (autosuggestions)"

printf "\n${CL_BOLD}${CL_GREEN}✨ Installation Complete!${CL_RESET}\n"
if [[ -d "$BACKUP_DIR" ]]; then
  log_info "Backups stored in: ${CL_BOLD}${BACKUP_DIR}${CL_RESET}"
fi
echo
