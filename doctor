#!/usr/bin/env bash
set -euo pipefail

# --- Colors & Symbols ---
# shellcheck source=lib/colors.sh
source "$(dirname "${BASH_SOURCE[0]}")/lib/colors.sh"
# shellcheck source=lib/links.sh
source "$(dirname "${BASH_SOURCE[0]}")/lib/links.sh"

SYM_OK="✔"
SYM_MISS="✖"
SYM_WARN="⚠"
SYM_NOTE="ℹ"

# --- Configuration ---
DOTFILES_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
required_commands=(git zsh nvim tmux)
optional_commands=(bat brew curl ddgr delta eza fd fnm rg vim fzf jq lazygit nnn kitty tldr uv zoxide)

missing_required=0
missing_optional=0
notices=0

# --- Helper Functions ---
log_header() { printf '\n%s%s==> %s%s\n' "$CL_BOLD" "$CL_MAGENTA" "$1" "$CL_RESET"; }

print_result() {
  local status="$1"
  local name="$2"
  local detail="${3:-}"
  local color=""
  local symbol=""

  case "$status" in
    OK)    color="$CL_GREEN";   symbol="$SYM_OK" ;;
    MISS)  color="$CL_RED";     symbol="$SYM_MISS" ;;
    WARN)  color="$CL_YELLOW";  symbol="$SYM_WARN" ;;
    NOTE)  color="$CL_BLUE";    symbol="$SYM_NOTE" ;;
    FAIL)  color="$CL_RED";     symbol="$SYM_MISS" ;;
    *)     color="$CL_RESET";   symbol=" " ;;
  esac

  printf '%s%s %s%-18s%s %s%s%s\n' "$color" "$symbol" "$CL_BOLD" "$name" "$CL_RESET" "$CL_CYAN" "$detail" "$CL_RESET"
}

check_command() {
  local kind="$1"
  local command_name="$2"

  if command -v "$command_name" >/dev/null 2>&1; then
    print_result "OK" "$command_name" "$(command -v "$command_name")"
  else
    if [[ "$kind" == "required" ]]; then
      print_result "MISS" "$command_name" "required"
      missing_required=1
    else
      print_result "MISS" "$command_name" "optional"
      missing_optional=$((missing_optional + 1))
    fi
  fi
}

# check_kitty_font
# Verifies the font_family named in kitty.conf actually resolves on this
# machine. kitty falls back silently when it does not, which is exactly how
# this repo shipped a config asking for an uninstalled font for years.
check_kitty_font() {
  local conf="${DOTFILES_DIR}/.config/kitty/kitty.conf"
  [[ -f "$conf" ]] || return 0

  local family
  family="$(awk '/^font_family[[:space:]]/ { $1=""; sub(/^[[:space:]]+/,""); print; exit }' "$conf")"
  [[ -n "$family" ]] || return 0

  local needle
  needle="$(printf '%s' "$family" | tr -d '[:space:]' | tr '[:upper:]' '[:lower:]')"

  if ls ~/Library/Fonts /Library/Fonts /System/Library/Fonts 2>/dev/null \
      | tr -d ' ' | tr '[:upper:]' '[:lower:]' \
      | grep -q "^${needle}[-.]"; then
    print_result "OK" "kitty font" "$family"
  else
    print_result "NOTE" "kitty font" "$family not installed — kitty falls back"
    notices=$((notices + 1))
  fi
}

# check_link <source> <target>
# Reports OK only when target is a symlink that actually resolves to source.
check_link() {
  local source="$1"
  local target="$2"
  local name
  name="$(display_path "$target")"

  if [[ ! -L "$target" ]]; then
    if [[ -e "$target" ]]; then
      print_result "NOTE" "$name" "real file, not linked — run ./install"
    else
      print_result "NOTE" "$name" "not linked — run ./install"
    fi
    notices=$((notices + 1))
    return
  fi

  if [[ "$(readlink "$target")" == "$source" ]]; then
    print_result "OK" "$name" "linked"
  else
    print_result "NOTE" "$name" "links elsewhere: $(readlink "$target")"
    notices=$((notices + 1))
  fi
}

# --- Execution ---
printf '%s%s🩺 Dotfiles Doctor%s\n' "$CL_BOLD" "$CL_CYAN" "$CL_RESET"

log_header "Required Tools"
for command_name in "${required_commands[@]}"; do
  check_command required "$command_name"
done

log_header "Optional Tools"
for command_name in "${optional_commands[@]}"; do
  check_command optional "$command_name"
done

log_header "Setup & Environment"
for_each_link check_link
check_kitty_font

if [[ -d "${HOME}/.oh-my-zsh" ]]; then
  print_result "OK" "oh-my-zsh" "installed"
else
  print_result "NOTE" "oh-my-zsh" "missing — run ./install"
  notices=$((notices + 1))
fi

if [[ -f "${HOME}/.zshrc-secrets" ]]; then
  print_result "OK" "secrets" "exists"
else
  print_result "NOTE" "secrets" "missing (~/.zshrc-secrets)"
  notices=$((notices + 1))
fi

if [[ -d "${HOME}/.local/share/nvim/lazy/lazy.nvim" ]]; then
  print_result "OK" "lazy.nvim" "installed"
else
  print_result "NOTE" "lazy.nvim" "will bootstrap on start"
  notices=$((notices + 1))
fi

if [[ -x "${HOME}/.local/share/nvim/python-provider/bin/python" ]] &&
  "${HOME}/.local/share/nvim/python-provider/bin/python" -c 'import pynvim' >/dev/null 2>&1; then
  print_result "OK" "nvim-python" "pynvim ready"
else
  print_result "NOTE" "nvim-python" "run ./install"
  notices=$((notices + 1))
fi

log_header "Runtime Managers"
if command -v node >/dev/null 2>&1; then
  print_result "OK" "node" "$(node --version)"
else
  print_result "NOTE" "node" "missing (install fnm)"
  notices=$((notices + 1))
fi

if command -v python3 >/dev/null 2>&1; then
  print_result "OK" "python3" "$(python3 --version 2>&1)"
else
  print_result "NOTE" "python3" "missing"
  notices=$((notices + 1))
fi

if command -v uv >/dev/null 2>&1; then
  print_result "OK" "uv" "$(uv --version)"
else
  print_result "NOTE" "uv" "optional (brew install uv)"
  notices=$((notices + 1))
fi

log_header "Summary"
if [[ "$missing_required" -eq 1 ]]; then
  print_result "FAIL" "required" "missing critical tools"
  exit 1
fi

if [[ "$missing_optional" -gt 0 ]]; then
  print_result "WARN" "optional" "${missing_optional} missing"
else
  print_result "OK" "optional" "all available"
fi

if [[ "$notices" -gt 0 ]]; then
  print_result "NOTE" "setup" "${notices} notices"
else
  print_result "OK" "setup" "ready"
fi

echo
