#!/usr/bin/env bash
set -euo pipefail

required_commands=(
  git
  zsh
  vim
  tmux
)

optional_commands=(
  bat
  brew
  curl
  ddgr
  delta
  eza
  fd
  nvim
  rg
  fzf
  jq
  lazygit
  nnn
  kitty
  tldr
  zoxide
)

missing_required=0
missing_optional=0
notices=0

print_header() {
  local title="$1"

  echo
  echo "$title"
  printf '%s\n' "----------------------------------------"
}

print_result() {
  local status="$1"
  local name="$2"
  local detail="${3:-}"

  if [[ -n "$detail" ]]; then
    printf '%-6s %-24s %s\n' "$status" "$name" "$detail"
  else
    printf '%-6s %s\n' "$status" "$name"
  fi
}

check_command() {
  local kind="$1"
  local command_name="$2"

  if command -v "$command_name" >/dev/null 2>&1; then
    print_result "OK" "$command_name" "$(command -v "$command_name")"
  else
    if [[ "$kind" == "required" ]]; then
      print_result "MISS" "$command_name" "required"
      missing_required=1
    else
      print_result "MISS" "$command_name" "optional"
      missing_optional=$((missing_optional + 1))
    fi
  fi
}

echo "Dotfiles Doctor"
print_header "Required tools"
for command_name in "${required_commands[@]}"; do
  check_command required "$command_name"
done

print_header "Optional tools"
for command_name in "${optional_commands[@]}"; do
  check_command optional "$command_name"
done

print_header "Setup"
if [[ -L "${HOME}/.zshrc" ]]; then
  print_result "OK" "~/.zshrc" "symlink"
else
  print_result "NOTE" "~/.zshrc" "not a symlink"
  notices=$((notices + 1))
fi

if [[ -f "${HOME}/.zshrc-secrets" ]]; then
  print_result "OK" "~/.zshrc-secrets" "exists"
else
  print_result "NOTE" "~/.zshrc-secrets" "missing"
  notices=$((notices + 1))
fi

if [[ -d "${HOME}/.local/share/nvim/lazy/lazy.nvim" ]]; then
  print_result "OK" "lazy.nvim" "installed"
else
  print_result "NOTE" "lazy.nvim" "will bootstrap on first nvim start"
  notices=$((notices + 1))
fi

print_header "Summary"
if [[ "$missing_required" -eq 1 ]]; then
  print_result "FAIL" "required tools" "missing"
  exit 1
fi

if [[ "$missing_optional" -gt 0 ]]; then
  print_result "WARN" "optional tools" "${missing_optional} missing"
else
  print_result "OK" "optional tools" "all available"
fi

if [[ "$notices" -gt 0 ]]; then
  print_result "NOTE" "setup notices" "$notices"
else
  print_result "OK" "setup" "ready"
fi

print_result "OK" "doctor" "finished"
