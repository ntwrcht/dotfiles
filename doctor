#!/usr/bin/env bash
set -euo pipefail

required_commands=(
  git
  zsh
  vim
  tmux
)

optional_commands=(
  bat
  brew
  curl
  ddgr
  delta
  eza
  fd
  nvim
  rg
  fzf
  jq
  lazygit
  nnn
  kitty
  tldr
  zoxide
)

optional_apps=(
  Alacritty
)

missing_required=0

check_command() {
  local kind="$1"
  local command_name="$2"

  if command -v "$command_name" >/dev/null 2>&1; then
    printf 'ok      %s\n' "$command_name"
  else
    printf 'missing %-8s %s\n' "$kind" "$command_name"
    if [[ "$kind" == "required" ]]; then
      missing_required=1
    fi
  fi
}

echo "Required tools"
for command_name in "${required_commands[@]}"; do
  check_command required "$command_name"
done

echo
echo "Optional tools"
for command_name in "${optional_commands[@]}"; do
  check_command optional "$command_name"
done

echo
echo "Optional apps"
for app_name in "${optional_apps[@]}"; do
  if [[ -d "/Applications/${app_name}.app" || -d "${HOME}/Applications/${app_name}.app" ]]; then
    printf 'ok      %s.app\n' "$app_name"
  else
    printf 'missing optional %s.app\n' "$app_name"
  fi
done

echo
if [[ -L "${HOME}/.zshrc" ]]; then
  echo "ok      ~/.zshrc is a symlink"
else
  echo "notice  ~/.zshrc is not a symlink"
fi

if [[ -f "${HOME}/.zshrc-secrets" ]]; then
  echo "ok      ~/.zshrc-secrets exists"
else
  echo "notice  ~/.zshrc-secrets is missing"
fi

if [[ -f "${HOME}/.vim/autoload/plug.vim" ]]; then
  echo "ok      vim-plug is installed"
else
  echo "notice  vim-plug is missing"
fi

if [[ "$missing_required" -eq 1 ]]; then
  echo
  echo "Some required tools are missing."
  exit 1
fi

echo "Doctor check finished."
