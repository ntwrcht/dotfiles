[user]
	name = Worachote Suwanyothin
	email = s.worachote@hotmail.com
[core]
	excludesfile = ~/.config/git/ignore
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	side-by-side = true
	line-numbers = true
	; Matches the Catppuccin Mocha palette used by kitty, tmux and nvim.
	syntax-theme = Catppuccin Mocha
	minus-style = syntax "#443244"
	minus-emph-style = syntax "#6b2d43"
	plus-style = syntax "#2c3b34"
	plus-emph-style = syntax "#3f5f4a"
[diff]
	colorMoved = default
[merge]
	conflictstyle = diff3
[difftool "sourcetree"]
	cmd = opendiff \"$LOCAL\" \"$REMOTE\"
	path =
[mergetool "sourcetree"]
	cmd = /Applications/Sourcetree.app/Contents/Resources/opendiff-w.sh \"$LOCAL\" \"$REMOTE\" -ancestor \"$BASE\" -merge \"$MERGED\"
	trustExitCode = true
[commit]
	template = ~/.config/git/commit-template
[push]
	autoSetupRemote = true
[url "git@gitlab.com:"]
	insteadOf = https://gitlab.com/
