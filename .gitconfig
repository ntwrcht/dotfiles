[user]
	name = Canvas-xxx
	email = s.worachote@hotmail.com
[core]
	excludesfile = /Users/worachotesuwanyothin/.gitignore_global
[difftool "sourcetree"]
	cmd = opendiff \"$LOCAL\" \"$REMOTE\"
	path = 
[mergetool "sourcetree"]
	cmd = /Applications/Sourcetree.app/Contents/Resources/opendiff-w.sh \"$LOCAL\" \"$REMOTE\" -ancestor \"$BASE\" -merge \"$MERGED\"
	trustExitCode = true
[commit]
	template = /Users/worachotesuwanyothin/.stCommitMsg
[push]
	autoSetupRemote = true
