# ─────────────────────────────────────────────────────────────
# Dotfiles repo .gitignore
#
# This repo is a symlink farm, NOT a home directory. Only rules
# that can actually match a path inside this repo belong here.
# ─────────────────────────────────────────────────────────────

# --- XDG config: track only the directories we manage ---
.config/*
!.config/git/
!.config/git/**
!.config/kitty/
!.config/kitty/**
!.config/nvim/
!.config/nvim/**

# --- Secrets: never commit ---
/.env
/.env.*
/.zshrc-secrets
/.zshrc.local
/*token*
/*credentials*
/.config/**/*token*
/.config/**/*credentials*

# --- Editor state (generated, machine-local) ---
/.config/nvim/undodir
/.config/nvim/plugged
/.config/nvim/.netrwhist
/nvim.log
/.vim/.netrwhist
/.vim/colors/
/.vim/autoload/plug.vim*
/.vim/bundle/
/.vim/plugged/
/.vim/view/
/.vim/pack/
/.viminfo
/doc/tags

# --- Shell state ---
/.zcompdump*
/.zsh-update
/.*history

# --- macOS ---
.DS_Store
.MacOSX
.Trash

# --- AI coding agents (generated state, local config, credentials) ---
# To track a specific file, add a negation below, e.g.:
#   !/.claude/settings.json
/.claude/
/.claude.json
/.claude.json.backup
/CLAUDE.local.md
/.agent/
/.agents/
/.aider*
/.codex/
/.cursor/
/.gemini/
/skills-lock.json
