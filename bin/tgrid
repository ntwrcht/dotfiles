#!/usr/bin/env bash
# tgrid — arrange the panes of the current tmux window in one command.
#
#   tgrid [N]             even grid, adding panes until there are N
#   tgrid main [N]        current pane large on the left (60%), rest stacked right
#   tgrid main-top [N]    current pane large on top (60%), rest side by side below
#   tgrid A:B[:C...]      uneven split, e.g. 1:3 → 25/75, 1:2:1 → 25/50/25
#
# A ratio sets widths when the panes sit side by side and heights when they are
# stacked; a window with both rows and columns is refused. Only the current
# window changes. New panes open in the current pane's directory.
#
# .tmux.conf binds <prefix>G and <prefix>M to this, which is why it is an
# executable on PATH rather than a zsh function. From a binding stdout is not
# a terminal, so messages go to the tmux status line instead.
set -euo pipefail

usage() {
  sed -n '4,7s/^#   //p' "$0"
}

msg() {
  if [[ -t 1 ]] || [[ -z "${TMUX-}" ]]; then
    printf 'tgrid: %s\n' "$1" >&2
  else
    tmux display-message "tgrid: $1" 2>/dev/null || printf 'tgrid: %s\n' "$1" >&2
  fi
}

die() { msg "$1"; exit "${2:-1}"; }

case "${1-}" in -h|--help) usage; exit 0 ;; esac

[[ -n "${TMUX-}" ]] || die "not inside tmux"

# Honours $TMUX_PANE, which the bindings set to the pane the key was pressed in.
pane="$(tmux display -p '#{pane_id}')"
window="$(tmux display -p -t "$pane" '#{window_id}')"
dir="$(tmux display -p -t "$pane" '#{pane_current_path}')"

pane_count() { tmux display -p -t "$window" '#{window_panes}'; }

# split <target> <-h|-v>: new pane beside target, focus unchanged.
split() {
  local err
  err="$(tmux split-window -d "$2" -t "$1" -c "$dir" 2>&1)" || die "${err:-split failed}"
}

# Split the largest pane, along its longer side (cells are ~2:1 tall), until
# the window holds $1 panes.
grow_to() {
  local target="$1" line largest w h
  while (( $(pane_count) < target )); do
    line="$(tmux list-panes -t "$window" \
      -F '#{e|*:#{pane_width},#{pane_height}} #{pane_id} #{pane_width} #{pane_height}' \
      | sort -rn | head -1)"
    read -r _ largest w h <<<"$line"
    if (( w > 2 * h )); then split "$largest" -h; else split "$largest" -v; fi
  done
}

parse_count() {
  [[ "$1" =~ ^[1-9][0-9]*$ ]] || { usage >&2; exit 2; }
  printf '%s' "$1"
}

grid() {
  local n="${1:-}"
  if [[ -n "$n" ]]; then
    local have
    have="$(pane_count)"
    if (( have > n )); then
      msg "window already has $have panes; tiling them"
    fi
    grow_to "$n"
  fi
  (( $(pane_count) > 1 )) || die "only one pane; split first or pass a count (tgrid 4)" 0
  tmux select-layout -t "$window" tiled
}

main_layout() {
  local layout="$1" option="$2" n="${3:-}" first
  [[ -n "$n" ]] && grow_to "$n"
  (( $(pane_count) > 1 )) || die "only one pane; split first or pass a count (tgrid main 4)" 0
  first="$(tmux list-panes -t "$window" -F '#{pane_id}' | head -1)"
  [[ "$first" != "$pane" ]] && tmux swap-pane -d -s "$pane" -t "$first"
  tmux set-window-option -t "$window" "$option" 60%
  tmux select-layout -t "$window" "$layout"
  tmux select-pane -t "$pane"
}

ratio() {
  local -a parts
  IFS=: read -r -a parts <<<"$1"
  local nparts="${#parts[@]}" sum=0 p
  for p in "${parts[@]}"; do
    [[ "$p" =~ ^[1-9][0-9]*$ ]] || { usage >&2; exit 2; }
    sum=$(( sum + p ))
  done

  local have axis
  have="$(pane_count)"
  if (( have == 1 )); then
    axis=h
  else
    # One row: every pane starts on the same line. One column: the same column.
    if (( $(tmux list-panes -t "$window" -F '#{pane_top}' | sort -u | wc -l) == 1 )); then
      axis=h
    elif (( $(tmux list-panes -t "$window" -F '#{pane_left}' | sort -u | wc -l) == 1 )); then
      axis=v
    else
      die "ratio needs panes in a single row or column"
    fi
  fi
  (( have <= nparts )) || die "ratio has $nparts parts but the window has $have panes"

  # Panes in order along the axis; new ones split off the last.
  local key size_fmt flag
  if [[ $axis == h ]]; then key=pane_left; size_fmt=window_width; flag=-x
  else key=pane_top; size_fmt=window_height; flag=-y; fi

  ordered() {
    tmux list-panes -t "$window" -F "#{$key} #{pane_id}" | sort -n | cut -d' ' -f2
  }
  while (( $(pane_count) < nparts )); do
    split "$(ordered | tail -1)" "-$axis"
  done

  local -a ids
  while read -r p; do ids+=("$p"); done < <(ordered)

  # Borders take one cell each; the last pane absorbs the rounding remainder.
  local total i size
  total=$(( $(tmux display -p -t "$window" "#{$size_fmt}") - (nparts - 1) ))
  for (( i = 0; i < nparts - 1; i++ )); do
    size=$(( total * parts[i] / sum ))
    (( size >= 1 )) || size=1
    tmux resize-pane -t "${ids[i]}" "$flag" "$size"
  done
}

# Parsed up front so a bad count exits before anything changes.
n=""
case "${1-}" in
  main|main-top) [[ -z "${2-}" ]] || n="$(parse_count "$2")" ;;
  ""|-h|--help|*:*) ;;
  *)             n="$(parse_count "$1")" ;;
esac

case "${1-}" in
  main)       main_layout main-vertical main-pane-width "$n" ;;
  main-top)   main_layout main-horizontal main-pane-height "$n" ;;
  *:*)        ratio "$1" ;;
  *)          grid "$n" ;;
esac
