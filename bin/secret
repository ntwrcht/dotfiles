#!/usr/bin/env bash
# secret — keep credentials in the macOS login Keychain, not in files.
#
# Every item is a generic password with service `dotfiles/NAME`, so `secret ls`
# (and a search for "dotfiles/" in Keychain Access) finds only these items.
#
#   secret add [-d DESC] NAME       prompt for the value, create or update it
#   pbpaste | secret add NAME       same, reading the value from stdin
#   secret get NAME                 print the value
#   secret has NAME                 exit 0 if it exists, 1 if not (silent)
#   secret ls [-l]                  list names (-l adds descriptions), never values
#   secret rm [-f] NAME             delete, asking first unless -f
#   secret run NAME... -- CMD ...   run CMD with NAME=value in its env only
#
# DESC is an optional note kept in the item's Keychain comment. `add` without
# -d keeps the current one; `-d ''` clears it.
#
# Values never go through argv: `add` hands them to `security -i` on stdin,
# and `run` exports them inside this process before exec'ing CMD. Design:
# docs/design/credential-management.md
set -euo pipefail

PREFIX="dotfiles/"

die() { printf 'secret: %s\n' "$1" >&2; exit 1; }

usage() {
  sed -n '2,17p' "$0" | sed 's/^# \{0,1\}//'
}

# Some tools read only their own Keychain item. For those names, `add` also
# writes that item and `rm` deletes it, so `secret` stays the one place to
# manage them. Prints "service<TAB>account", or nothing for other names.
mirror_of() {
  local login
  case "$1" in
    JIRA_API_TOKEN)
      # jira-cli looks up service "jira-cli", account = its configured login.
      login="$(awk '/^login:/ { print $2 }' "$HOME/.config/.jira/.config.yml" 2>/dev/null)"
      [[ -n "$login" ]] && printf 'jira-cli\t%s\n' "$login"
      ;;
  esac
  return 0
}

# quote TEXT: escape backslashes and double quotes for a `security -i` line.
quote() {
  local text="${1//\\/\\\\}"
  printf '%s' "${text//\"/\\\"}"
}

# store SERVICE ACCOUNT VALUE [COMMENT] — create or update one generic password.
# Without COMMENT, an existing item keeps its comment. The command goes to
# `security -i` on stdin, so the value never reaches argv. (security's own -w
# prompt truncates input to 128 characters; -i caps a line near 4 KB.)
store() {
  local value="$3" comment=""
  [[ ${#value} -le 3800 ]] || die "value is ${#value} characters; the limit is 3800"
  [[ $# -ge 4 ]] && comment=" -j \"$(quote "$4")\""
  printf 'add-generic-password -a "%s" -s "%s" -l "%s"%s -U -w "%s"\n' \
    "$2" "$1" "$1" "$comment" "$(quote "$value")" \
    | security -i >/dev/null 2>&1 || die "could not write $1 to Keychain"
}

sync_mirror() {
  local target service account value
  target="$(mirror_of "$1")"
  [[ -n "$target" ]] || return 0
  IFS=$'\t' read -r service account <<<"$target"
  value="$(cmd_get "$1")"
  store "$service" "$account" "$value"
  printf 'secret: also updated %s (%s)\n' "$service" "$account" >&2
}

check_name() {
  [[ "${1-}" =~ ^[A-Za-z0-9_./-]+$ ]] || die "invalid name: '${1-}' (use A-Z a-z 0-9 _ . / -)"
}

cmd_add() {
  local usage="usage: secret add [-d DESC] NAME (the value is prompted, or read from stdin)"
  local desc="" has_desc=0 args=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -d) [[ $# -ge 2 ]] || die "$usage"; desc="$2"; has_desc=1; shift 2 ;;
      *) args+=("$1"); shift ;;
    esac
  done
  [[ ${#args[@]} -eq 1 ]] || die "$usage"
  set -- "${args[0]}"
  check_name "$1"
  [[ ${#desc} -le 200 ]] || die "description is ${#desc} characters; the limit is 200"
  [[ "$desc" != *[[:cntrl:]]* ]] || die "description must be one line with no tabs"
  local value again
  if [[ -t 0 ]]; then
    read -r -s -p "Value for $1: " value; printf '\n' >&2
    read -r -s -p "Retype: " again; printf '\n' >&2
    [[ "$value" == "$again" ]] || die "values did not match; nothing saved"
  else
    IFS= read -r value || [[ -n "$value" ]] || die "no value on stdin; nothing saved"
  fi
  [[ -n "$value" ]] || die "empty value; nothing saved"
  if [[ "$has_desc" -eq 1 ]]; then
    store "$PREFIX$1" "$USER" "$value" "$desc"
  else
    store "$PREFIX$1" "$USER" "$value"
  fi
  printf 'secret: saved %s (%d characters)\n' "$1" "${#value}" >&2
  sync_mirror "$1"
}

cmd_get() {
  [[ $# -eq 1 ]] || die "usage: secret get NAME"
  check_name "$1"
  security find-generic-password -a "$USER" -s "$PREFIX$1" -w 2>/dev/null \
    || die "not found: $1"
}

cmd_has() {
  [[ $# -eq 1 ]] || die "usage: secret has NAME"
  check_name "$1"
  security find-generic-password -a "$USER" -s "$PREFIX$1" >/dev/null 2>&1 || exit 1
}

cmd_ls() {
  local long=0
  if [[ "${1-}" == "-l" ]]; then long=1; shift; fi
  [[ $# -eq 0 ]] || die "usage: secret ls [-l]"
  # Without -d, dump-keychain prints attributes only, never secret data.
  if [[ "$long" -eq 0 ]]; then
    security dump-keychain 2>/dev/null \
      | sed -n "s|^ *\"svce\"<blob>=\"${PREFIX}\(.*\)\"\$|\1|p" \
      | sort -u
    return
  fi

  # Each item's attributes end at the next "keychain:" line. Print one
  # "NAME<TAB>txt|hex<TAB>COMMENT" row per item; non-ASCII comments come as hex.
  local names=() descs=() name kind desc width=0 i
  while IFS=$'\t' read -r name kind desc; do
    [[ "$kind" == hex ]] && desc="$(printf '%s' "$desc" | xxd -r -p)"
    names+=("$name"); descs+=("$desc")
    (( ${#name} > width )) && width=${#name}
  done < <(security dump-keychain 2>/dev/null | awk -v p="$PREFIX" '
    function flush() { if (svc != "") print svc "\t" kind "\t" desc; svc = ""; kind = "txt"; desc = "" }
    /^keychain: / { flush(); next }
    /^ *"svce"<blob>="/ {
      s = $0; sub(/^ *"svce"<blob>="/, "", s); sub(/"$/, "", s)
      if (index(s, p) == 1) svc = substr(s, length(p) + 1)
      next
    }
    /^ *"icmt"<blob>=0x/ { s = $0; sub(/^ *"icmt"<blob>=0x/, "", s); sub(/ .*/, "", s); kind = "hex"; desc = s; next }
    /^ *"icmt"<blob>="/ { s = $0; sub(/^ *"icmt"<blob>="/, "", s); sub(/"$/, "", s); kind = "txt"; desc = s; next }
    END { flush() }
  ' | sort -t $'\t' -u -k1,1)

  for i in "${!names[@]}"; do
    if [[ -n "${descs[$i]}" ]]; then
      printf '%-*s  %s\n' "$width" "${names[$i]}" "${descs[$i]}"
    else
      printf '%s\n' "${names[$i]}"
    fi
  done
}

cmd_rm() {
  local force=0
  if [[ "${1-}" == "-f" ]]; then force=1; shift; fi
  [[ $# -eq 1 ]] || die "usage: secret rm [-f] NAME"
  check_name "$1"
  "$0" has "$1" || die "not found: $1"
  if [[ "$force" -eq 0 ]]; then
    local reply
    read -r -p "Delete $PREFIX$1? [y/N] " reply
    [[ "$reply" =~ ^[yY]$ ]] || { printf 'secret: kept %s\n' "$1" >&2; exit 1; }
  fi
  security delete-generic-password -a "$USER" -s "$PREFIX$1" >/dev/null 2>&1
  printf 'secret: deleted %s\n' "$1" >&2
  local target service account
  target="$(mirror_of "$1")"
  if [[ -n "$target" ]]; then
    IFS=$'\t' read -r service account <<<"$target"
    security delete-generic-password -a "$account" -s "$service" >/dev/null 2>&1 \
      && printf 'secret: also deleted %s (%s)\n' "$service" "$account" >&2
  fi
  return 0
}

cmd_run() {
  local names=()
  while [[ $# -gt 0 && "$1" != "--" ]]; do
    names+=("$1")
    shift
  done
  [[ $# -gt 0 && ${#names[@]} -gt 0 ]] || die "usage: secret run NAME... -- CMD [ARGS]"
  shift
  [[ $# -gt 0 ]] || die "usage: secret run NAME... -- CMD [ARGS]"

  # Resolve every value before exporting any, so a missing one runs nothing.
  local values=() name
  for name in "${names[@]}"; do
    [[ "$name" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || die "not a valid env var name: '$name'"
    values+=("$(cmd_get "$name")") || exit 1
  done

  local i
  for i in "${!names[@]}"; do
    export "${names[$i]}=${values[$i]}"
  done
  exec "$@"
}

command -v security >/dev/null 2>&1 || die "macOS 'security' not found"

sub="${1-}"
[[ $# -gt 0 ]] && shift
case "$sub" in
  add) cmd_add "$@" ;;
  get) cmd_get "$@" ;;
  has) cmd_has "$@" ;;
  ls)  cmd_ls "$@" ;;
  rm)  cmd_rm "$@" ;;
  run) cmd_run "$@" ;;
  -h|--help|help|"") usage ;;
  *) die "unknown command: $sub (see secret -h)" ;;
esac
